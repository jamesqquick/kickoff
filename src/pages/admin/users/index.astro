---
// Platform admin: list all users with their capability flags.
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SectionCard from "@/components/SectionCard.astro";
import { getDb } from "@/lib/db";

const user = Astro.locals.user;
if (!user || user.role !== "admin") {
  return Astro.redirect("/dashboard");
}

// Fetch all users directly from the auth table via raw D1.
const db = getDb();
const usersResult = await db.$client
  .prepare(
    'SELECT id, name, email, role, isCoach, isDirector, createdAt FROM "user" ORDER BY createdAt DESC'
  )
  .all<{
    id: string;
    name: string;
    email: string;
    role: string;
    isCoach: number;
    isDirector: number;
    createdAt: number;
  }>();

const users = usersResult.results ?? [];
---

<AppLayout title="Admin — Users" activeNav="admin-users">
  <div class="p-4 sm:p-6 lg:p-8">
    <PageHeader
      eyebrow="Platform Admin"
      title="All Users"
      subtitle={`${users.length} registered user${users.length !== 1 ? "s" : ""}`}
    />

    <SectionCard>
      {users.length === 0 ? (
        <p class="text-sm text-(--color-muted) text-center py-8">No users found.</p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-(--color-border)">
                <th class="text-left px-5 py-3 text-xs font-semibold text-(--color-muted) uppercase tracking-wider">Name</th>
                <th class="text-left px-5 py-3 text-xs font-semibold text-(--color-muted) uppercase tracking-wider">Email</th>
                <th class="text-left px-5 py-3 text-xs font-semibold text-(--color-muted) uppercase tracking-wider">Role</th>
                <th class="text-left px-5 py-3 text-xs font-semibold text-(--color-muted) uppercase tracking-wider">Capabilities</th>
              </tr>
            </thead>
            <tbody>
              {users.map((u) => (
                <tr class="border-b border-(--color-border-soft) last:border-0 hover:bg-(--color-background) transition-colors">
                  <td class="px-5 py-3 font-medium text-(--color-foreground)">{u.name}</td>
                  <td class="px-5 py-3 text-(--color-muted)">{u.email}</td>
                  <td class="px-5 py-3">
                    {u.role === "admin" ? (
                      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-purple-100 text-purple-700">
                        Admin
                      </span>
                    ) : (
                      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-(--color-border-soft) text-(--color-muted)">
                        User
                      </span>
                    )}
                  </td>
                  <td class="px-5 py-3">
                    <div class="flex items-center gap-2">
                      {u.isCoach ? (
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-700">
                          Coach
                        </span>
                      ) : null}
                      {u.isDirector ? (
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-sky-100 text-sky-700">
                          Director
                        </span>
                      ) : null}
                      {!u.isCoach && !u.isDirector && u.role !== "admin" ? (
                        <span class="text-xs text-(--color-muted)">—</span>
                      ) : null}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </SectionCard>
  </div>
</AppLayout>
