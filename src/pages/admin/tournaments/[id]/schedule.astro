---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { makeTournamentService } from "@/services/tournament-service";
import { NotFoundError } from "@/lib/errors";

const user = Astro.locals.user;
if (!user || user.role !== "admin") {
  return Astro.redirect("/");
}

const { id } = Astro.params;

let tournament;
try {
  tournament = await makeTournamentService().getTournament(id!);
} catch (err) {
  if (err instanceof NotFoundError) {
    return Astro.redirect("/admin/tournaments");
  }
  throw err;
}
---

<AppLayout title={`Schedule — ${tournament.name}`} activeNav="admin-schedule">
  <div class="p-4 sm:p-6 lg:p-8">
    <PageHeader
      eyebrow={tournament.name}
      title="Schedule"
      subtitle="Match schedule for this tournament."
    />
    <p class="text-sm text-(--color-muted) mt-2">Schedule coming soon.</p>
  </div>
</AppLayout>
