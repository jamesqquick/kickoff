---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import BrandMark from "@/components/BrandMark.astro";
import FormField from "@/components/FormField.astro";
import { getAuth } from "@/lib/auth";

// After a POST we always redirect here with ?submitted=1 — prevents account
// enumeration by never revealing whether the email exists.
const submitted = Astro.url.searchParams.get("submitted") === "1";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email = String(form.get("email") ?? "").trim();

  try {
    await getAuth().api.requestPasswordReset({
      body: {
        email,
        redirectTo: `${Astro.url.origin}/reset-password`,
      },
      headers: Astro.request.headers,
    });
  } catch {
    // Intentionally swallowed — always show generic success to prevent
    // account enumeration (identical behaviour regardless of outcome).
  }

  return Astro.redirect("/forgot-password?submitted=1");
}
---

<BaseLayout title="Forgot Password">
  <div class="min-h-screen grid grid-cols-1 lg:grid-cols-2">
    <!-- Left: branding panel — hidden on mobile/tablet -->
    <div
      class="hidden lg:flex relative flex-col justify-between p-14 border-r border-(--color-border) overflow-hidden"
      style="background: radial-gradient(circle at 30% 20%, rgba(5,150,105,0.16), transparent 45%), radial-gradient(circle at 80% 80%, rgba(234,88,12,0.12), transparent 45%), #ffffff;"
    >
      <div class="absolute -bottom-32 -right-20 w-[340px] h-[340px] rounded-full" style="border: 2px solid rgba(5,150,105,0.12);" />

      <div class="flex items-center gap-2.5 relative z-10">
        <BrandMark size="md" />
        <span class="font-display font-bold text-xl text-(--color-foreground)">Kickoff</span>
      </div>

      <div class="relative z-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-(--color-primary) mb-4">
          Tournament Operations, Simplified
        </p>
        <h1 class="font-display text-[42px] leading-[1.1] text-(--color-foreground) max-w-sm">
          Run your soccer tournament like a pro.
        </h1>
        <p class="mt-5 text-(--color-muted) text-[15px] max-w-[400px] leading-relaxed">
          Register teams, manage rosters, build schedules, and track every
          match — all from one clean dashboard built for organizers and coaches.
        </p>
      </div>

      <p class="text-xs text-(--color-muted-fg) relative z-10">© 2026 Kickoff · Spring Invitational Cup</p>
    </div>

    <!-- Right: form panel -->
    <div class="flex items-center justify-center p-6 sm:p-10 bg-(--color-background)">
      <div class="w-full max-w-[400px]">
        <!-- Brand mark — mobile only -->
        <div class="flex items-center gap-2 mb-8 lg:hidden">
          <BrandMark size="sm" />
          <span class="font-display font-bold text-lg text-(--color-foreground)">Kickoff</span>
        </div>

        <h2 class="font-display text-2xl font-semibold text-(--color-foreground) mb-1">Forgot your password?</h2>

        {submitted ? (
          <!-- Generic success — shown regardless of whether the email exists -->
          <div>
            <p class="text-sm text-(--color-muted) mb-6">
              If an account exists for that email address, you'll receive a
              password reset link shortly. Check your inbox (and spam folder).
            </p>
            <p class="text-sm text-green-700 mb-6 p-3 rounded-md bg-green-50 border border-green-200">
              Reset instructions sent. Check your email.
            </p>
            <a href="/signin" class={cn(buttonVariants({ variant: "outline", size: "xl" }), "w-full text-center")}>
              Back to Sign In
            </a>
          </div>
        ) : (
          <div>
            <p class="text-sm text-(--color-muted) mb-6">
              Enter the email address associated with your account and we'll
              send you a link to reset your password.
            </p>
            <form method="POST">
              <div class="space-y-4">
                <FormField
                  label="Email"
                  type="email"
                  name="email"
                  placeholder="you@email.com"
                  required
                />
                <button
                  type="submit"
                  class={cn(buttonVariants({ variant: "default", size: "xl" }), "w-full")}
                >
                  Send Reset Link →
                </button>
              </div>
            </form>
            <p class="text-sm text-(--color-muted) text-center mt-6">
              Remember your password?{" "}
              <a href="/signin" class="text-(--color-primary) hover:underline">Sign in</a>
            </p>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
