---
import AppLayout from "@/layouts/AppLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import PageHeader from "@/components/PageHeader.astro";
import AdminBreadcrumb from "@/components/AdminBreadcrumb.astro";
import SectionCard from "@/components/SectionCard.astro";
import FormField from "@/components/FormField.astro";
import { SaveTournamentButton } from "@/components/SaveTournamentButton";

const user = Astro.locals.user;
if (!user || (!user.isDirector && user.role !== "admin")) {
  return Astro.redirect("/dashboard");
}
---

<AppLayout title="New Tournament" activeNav="director-tournaments">
  <div class="p-4 sm:p-6 lg:p-8 max-w-3xl">
    <AdminBreadcrumb crumbs={[
      { label: "My Tournaments", href: "/director/tournaments" },
      { label: "New" },
    ]} />

    <PageHeader title="Create Tournament" subtitle="Fill in the details. Add divisions after saving." />

    <SectionCard class="p-5 sm:p-7">
      <h2 class="font-display text-lg font-semibold text-(--color-foreground) mb-1">Tournament Details</h2>
      <p class="text-sm text-(--color-muted) mb-6">
        The slug is auto-generated from the name and must be unique.
      </p>

      <div class="grid grid-cols-1 gap-4 mb-4">
        <FormField label="Tournament name" name="name" required placeholder="e.g. Spring Invitational 2026" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <FormField label="Start date" name="startDate" type="date" />
        <FormField label="End date" name="endDate" type="date" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <FormField label="Registration deadline" name="registrationDeadline" type="date" hint="Teams cannot register after this date." />
        <FormField label="Location / venue" name="location" placeholder="e.g. Austin Sports Complex" />
      </div>

      <div class="mb-4">
        <FormField label="Description" name="description" placeholder="Shown to coaches on the tournament page (optional)." />
      </div>

      <div class="mb-4">
        <FormField
          label="Registration Fee (USD)"
          name="registrationFee"
          hint="Enter in dollars (e.g. 150 = $150). Leave blank for free tournaments. Coaches see this as informational — you collect payment yourself."
        >
          <input
            name="registrationFee"
            type="number"
            min="0"
            step="0.01"
            placeholder="0.00"
            class="w-full h-10 px-3 rounded-md border border-(--color-border) bg-(--color-surface) text-sm text-(--color-foreground) placeholder:text-(--color-muted-fg) focus:outline-none focus:ring-2 focus:ring-(--color-primary) focus:ring-offset-1"
          />
        </FormField>
      </div>

      <div class="mb-6">
        <FormField
          label="Payment Instructions"
          name="paymentInstructions"
          hint="Shown to coaches on the registration page. Include your payment handles, preferred memo format, and any deadline."
        >
          <textarea
            name="paymentInstructions"
            rows="3"
            maxlength="1000"
            placeholder="e.g. Venmo: @your-handle · Zelle: you@email.com&#10;Memo: &quot;Fall Championship — [team name]&quot;&#10;Payment due within 7 days of registration."
            class="w-full px-3 py-2 rounded-md border border-(--color-border) bg-(--color-surface) text-sm text-(--color-foreground) placeholder:text-(--color-muted-fg) focus:outline-none focus:ring-2 focus:ring-(--color-primary) focus:ring-offset-1 resize-none"
          ></textarea>
        </FormField>
      </div>

      <div class="flex justify-between">
        <a href="/director/tournaments" class={cn(buttonVariants({ variant: "outline" }))}>← Cancel</a>
        <SaveTournamentButton client:load mode="create" redirectBase="/director/tournaments" />
      </div>
    </SectionCard>
  </div>
</AppLayout>
