---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import TournamentPageHeader from "@/components/TournamentPageHeader.astro";
import SectionCard from "@/components/SectionCard.astro";
import { ManagersPanel } from "@/components/ManagersPanel";
import { makeTournamentService } from "@/services/tournament-service";
import { makeTournamentManagerService } from "@/services/tournament-manager-service";
import { getTournamentStatus } from "@/lib/utils";
import { NotFoundError } from "@/lib/errors";
import { BETTER_AUTH_URL } from "astro:env/server";

const user = Astro.locals.user;
if (!user || (!user.isDirector && user.role !== "admin")) {
  return Astro.redirect("/dashboard");
}

const { id } = Astro.params;

let tournament, managers, invites, allTournaments;
try {
  [tournament, allTournaments] = await Promise.all([
    makeTournamentService().getTournament(id!),
    makeTournamentService().listForDirector(user.id),
  ]);
  [managers, invites] = await Promise.all([
    makeTournamentManagerService().listManagers(id!, user),
    makeTournamentManagerService().listInvites(id!, user),
  ]);
} catch (err) {
  if (err instanceof NotFoundError) return Astro.redirect("/director/tournaments");
  throw err;
}

const allForSwitcher = allTournaments.map((t) => ({
  id: t.id,
  name: t.name,
  status: getTournamentStatus(t),
}));

// Determine if the current user is the tournament owner (can add/remove managers)
const isOwner = tournament.createdBy === user.id || user.role === "admin";

// Base URL for the invite link (e.g. https://kickoff.local)
const baseUrl = BETTER_AUTH_URL.replace(/\/$/, "");
---

<AppLayout title={`Managers — ${tournament.name}`} activeNav="director-tournaments">
  <TournamentPageHeader
    tournament={tournament}
    allTournaments={allForSwitcher}
    section="Managers"
    sectionSlug="managers"
  />

  <div class="p-4 sm:p-6 lg:p-8 max-w-3xl">
    <PageHeader
      title="Tournament Managers"
      subtitle="Co-directors who have access to manage this tournament."
    />

    <ManagersPanel
      client:load
      tournamentId={id!}
      isOwner={isOwner}
      initialManagers={managers}
      initialInvites={invites}
      baseUrl={baseUrl}
    />
  </div>
</AppLayout>
