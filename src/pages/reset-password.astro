---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import BrandMark from "@/components/BrandMark.astro";
import FormField from "@/components/FormField.astro";
import { getAuth } from "@/lib/auth";
import { redirectWithSuccess } from "@/lib/http";

const callbackError = Astro.url.searchParams.get("error");

// The token arrives in two ways:
//   GET  – Better Auth's callback redirects here with ?token=... in the URL.
//   POST – The token is carried through as a hidden form field.
// We track `activeToken` so the template can always embed it in the hidden field.
let activeToken = Astro.url.searchParams.get("token") ?? "";
let formError: string | null = null;

// No token and no error on a GET means the user navigated here directly.
// On POST the token arrives in the body (not the URL), so skip this guard.
if (Astro.request.method !== "POST" && !activeToken && !callbackError) {
  return Astro.redirect("/forgot-password");
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  activeToken = String(form.get("token") ?? "").trim();
  const newPassword = String(form.get("newPassword") ?? "");
  const confirmPassword = String(form.get("confirmPassword") ?? "");

  if (!activeToken) {
    formError = "Reset token is missing. Please request a new reset link.";
  } else if (newPassword.length < 8) {
    formError = "New password must be at least 8 characters.";
  } else if (newPassword !== confirmPassword) {
    formError = "Passwords don't match.";
  } else {
    try {
      await getAuth().api.resetPassword({
        body: { newPassword, token: activeToken },
        headers: Astro.request.headers,
      });
      return redirectWithSuccess("/signin", "Your password has been reset. Please sign in.");
    } catch {
      formError =
        "This reset link has expired or is invalid. Please request a new one.";
    }
  }
}
---

<BaseLayout title="Reset Password">
  <div class="min-h-screen grid grid-cols-1 lg:grid-cols-2">
    <!-- Left: branding panel — hidden on mobile/tablet -->
    <div
      class="hidden lg:flex relative flex-col justify-between p-14 border-r border-(--color-border) overflow-hidden"
      style="background: radial-gradient(circle at 30% 20%, rgba(5,150,105,0.16), transparent 45%), radial-gradient(circle at 80% 80%, rgba(234,88,12,0.12), transparent 45%), #ffffff;"
    >
      <div class="absolute -bottom-32 -right-20 w-[340px] h-[340px] rounded-full" style="border: 2px solid rgba(5,150,105,0.12);" />

      <div class="flex items-center gap-2.5 relative z-10">
        <BrandMark size="md" />
        <span class="font-display font-bold text-xl text-(--color-foreground)">Kickoff</span>
      </div>

      <div class="relative z-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-(--color-primary) mb-4">
          Tournament Operations, Simplified
        </p>
        <h1 class="font-display text-[42px] leading-[1.1] text-(--color-foreground) max-w-sm">
          Run your soccer tournament like a pro.
        </h1>
        <p class="mt-5 text-(--color-muted) text-[15px] max-w-[400px] leading-relaxed">
          Register teams, manage rosters, build schedules, and track every
          match — all from one clean dashboard built for organizers and coaches.
        </p>
      </div>

      <p class="text-xs text-(--color-muted-fg) relative z-10">© 2026 Kickoff · Spring Invitational Cup</p>
    </div>

    <!-- Right: form panel -->
    <div class="flex items-center justify-center p-6 sm:p-10 bg-(--color-background)">
      <div class="w-full max-w-[400px]">
        <!-- Brand mark — mobile only -->
        <div class="flex items-center gap-2 mb-8 lg:hidden">
          <BrandMark size="sm" />
          <span class="font-display font-bold text-lg text-(--color-foreground)">Kickoff</span>
        </div>

        <h2 class="font-display text-2xl font-semibold text-(--color-foreground) mb-1">Reset your password</h2>

        {callbackError === "INVALID_TOKEN" ? (
          <!-- Better Auth redirected here with ?error=INVALID_TOKEN (expired / already used) -->
          <div>
            <p class="text-sm text-(--color-muted) mb-6">
              This reset link has expired or is invalid.
            </p>
            <p class="text-sm text-red-600 mb-6 p-3 rounded-md bg-red-50 border border-red-200">
              The link you followed is no longer valid. Reset links expire after 1 hour.
            </p>
            <a
              href="/forgot-password"
              class={cn(buttonVariants({ variant: "default", size: "xl" }), "w-full text-center")}
            >
              Request a new link →
            </a>
          </div>
        ) : (
          <div>
            <p class="text-sm text-(--color-muted) mb-6">
              Enter a new password for your account. It must be at least 8 characters.
            </p>
            {formError && (
              <p class="text-sm text-red-600 mb-4 p-3 rounded-md bg-red-50 border border-red-200">
                {formError}{" "}
                {formError.includes("expired") && (
                  <a href="/forgot-password" class="underline font-medium">Request a new link.</a>
                )}
              </p>
            )}
            <form method="POST" id="reset-form">
              <!-- Token round-trips through the POST via hidden field -->
              <input type="hidden" name="token" value={activeToken} />
              <div class="space-y-4">
                <FormField
                  label="New password"
                  type="password"
                  name="newPassword"
                  placeholder="At least 8 characters"
                  minlength={8}
                  required
                />
                <FormField
                  label="Confirm new password"
                  type="password"
                  name="confirmPassword"
                  placeholder="Repeat your new password"
                  minlength={8}
                  required
                />
                <button
                  type="submit"
                  class={cn(buttonVariants({ variant: "default", size: "xl" }), "w-full")}
                >
                  Reset Password →
                </button>
              </div>
            </form>
            <p class="text-sm text-(--color-muted) text-center mt-6">
              Remember your password?{" "}
              <a href="/signin" class="text-(--color-primary) hover:underline">Sign in</a>
            </p>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Client-side: confirm password match before submit for instant feedback.
  const form = document.getElementById("reset-form") as HTMLFormElement | null;
  if (form) {
    form.addEventListener("submit", (e) => {
      const newPw = form.querySelector<HTMLInputElement>('[name="newPassword"]');
      const confirmPw = form.querySelector<HTMLInputElement>('[name="confirmPassword"]');
      if (newPw && confirmPw && newPw.value !== confirmPw.value) {
        e.preventDefault();
        confirmPw.setCustomValidity("Passwords don't match.");
        confirmPw.reportValidity();
      } else {
        confirmPw?.setCustomValidity("");
      }
    });
  }
</script>
