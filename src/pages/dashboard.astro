---
// Role-aware dashboard — single route, no redirect to a role-specific URL.
// Shows sections based on the user's isCoach / isDirector / role flags.
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SectionCard from "@/components/SectionCard.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { makeTeamService } from "@/services/team-service";
import { makeTournamentService } from "@/services/tournament-service";
import { makeTournamentRegistrationService } from "@/services/tournament-registration-service";
import TeamCrest from "@/components/TeamCrest.astro";
import { teamColorGradient } from "@/lib/utils";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/signin");

const isAdmin = user.role === "admin";
const isCoach = !!user.isCoach || isAdmin;
const isDirector = !!user.isDirector || isAdmin;

// ── Fetch data for each relevant section ───────────────────────────────────

let myTeams: Awaited<ReturnType<typeof makeTeamService>["listByCoach"]> = [];
let myTournaments: Awaited<ReturnType<typeof makeTournamentService>["listForDirector"]> = [];
let myRegistrations: import("@/repositories/tournament-registration-repository").RegistrationWithDetails[] = [];
let pendingRegistrations: Awaited<ReturnType<typeof makeTournamentRegistrationService>["getPendingRegistrationsForDirector"]> = [];

if (isCoach && !isAdmin) {
  myTeams = await makeTeamService().listByCoach(user.id);
  // Aggregate registrations across all owned teams
  for (const team of myTeams) {
    const regs = await makeTournamentRegistrationService().getRegistrationsForTeam(team.id);
    myRegistrations = [...myRegistrations, ...regs];
  }
}

if (isDirector && !isAdmin) {
  myTournaments = await makeTournamentService().listForDirector(user.id);
  pendingRegistrations = await makeTournamentRegistrationService().getPendingRegistrationsForDirector(user.id);
}

// Admin stats
let totalTournaments = 0;
if (isAdmin) {
  const allTournaments = await makeTournamentService().listTournaments();
  totalTournaments = allTournaments.length;
}
---

<AppLayout title="Dashboard" activeNav="dashboard">
  <div class="p-4 sm:p-6 lg:p-8">
    <PageHeader
      title="Dashboard"
      subtitle={`Welcome back, ${user.name?.split(" ")[0] ?? "there"}.`}
    />

    {/* ── Platform Admin ─────────────────────────────────────────── */}
    {isAdmin && (
      <div class="space-y-6">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="rounded-xl border border-(--color-border) bg-(--color-card) p-5">
            <p class="text-2xl font-bold text-(--color-foreground)">{totalTournaments}</p>
            <p class="text-sm text-(--color-muted) mt-1">Total Tournaments</p>
          </div>
          <div class="rounded-xl border border-(--color-border) bg-(--color-card) p-5">
            <p class="text-2xl font-bold text-(--color-foreground)">—</p>
            <p class="text-sm text-(--color-muted) mt-1">Total Teams</p>
          </div>
          <div class="rounded-xl border border-(--color-border) bg-(--color-card) p-5">
            <p class="text-2xl font-bold text-(--color-foreground)">—</p>
            <p class="text-sm text-(--color-muted) mt-1">Total Users</p>
          </div>
          <div class="rounded-xl border border-(--color-border) bg-(--color-card) p-5">
            <p class="text-2xl font-bold text-(--color-foreground)">—</p>
            <p class="text-sm text-(--color-muted) mt-1">Registrations</p>
          </div>
        </div>
        <SectionCard class="p-5">
          <h3 class="font-display font-semibold text-(--color-foreground) mb-3">Platform links</h3>
          <div class="flex flex-wrap gap-3">
            <a href="/admin/tournaments" class={cn(buttonVariants({ variant: "outline" }))}>All Tournaments</a>
            <a href="/admin/teams" class={cn(buttonVariants({ variant: "outline" }))}>All Teams</a>
            <a href="/admin/users" class={cn(buttonVariants({ variant: "outline" }))}>All Users</a>
          </div>
        </SectionCard>
      </div>
    )}

    {/* ── Coach section ──────────────────────────────────────────── */}
    {isCoach && !isAdmin && (
      <div class="space-y-6 mb-8">
        {myTeams.length === 0 ? (
          <>
            <h2 class="font-display text-lg font-semibold text-(--color-foreground)">My Teams</h2>
            <SectionCard class="p-8 text-center">
              <p class="text-sm text-(--color-muted) mb-4">You haven't created any teams yet.</p>
              <a href="/teams/register" class={cn(buttonVariants({ variant: "default" }))}>Create a team</a>
            </SectionCard>
          </>
        ) : (
          <SectionCard title="My Teams">
            <div slot="header-action">
              <a href="/teams/register" class={cn(buttonVariants({ variant: "outline" }), "h-7 px-3 text-xs")}>
                + New Team
              </a>
            </div>
            <table class="w-full">
              <thead>
                <tr class="border-b border-(--color-border)">
                  <th class="text-left text-xs font-semibold uppercase tracking-wider text-(--color-muted-fg) px-5 py-3">Team</th>
                  <th class="hidden sm:table-cell text-left text-xs font-semibold uppercase tracking-wider text-(--color-muted-fg) px-5 py-3">City</th>
                  <th class="px-5 py-3"></th>
                </tr>
              </thead>
              <tbody>
                {myTeams.slice(0, 5).map((team) => (
                  <tr class="border-b border-(--color-border-soft) last:border-0 hover:bg-(--color-background) transition-colors">
                    <td class="px-5 py-3.5">
                      <div class="flex items-center gap-3">
                        <TeamCrest
                          initials={team.shortName ?? team.name.slice(0, 2).toUpperCase()}
                          gradient={teamColorGradient(team.color)}
                          size="md"
                        />
                        <span class="font-semibold text-sm text-(--color-foreground)">{team.name}</span>
                      </div>
                    </td>
                    <td class="hidden sm:table-cell px-5 py-3.5 text-sm text-(--color-muted)">{team.city}</td>
                    <td class="px-5 py-3.5">
                      <div class="flex items-center gap-2 justify-end">
                        <a href={`/teams/${team.id}/edit`} class={cn(buttonVariants({ variant: "outline" }), "h-7 px-3 text-xs")}>Edit</a>
                        <a href={`/teams/${team.id}`} class={cn(buttonVariants({ variant: "outline" }), "h-7 px-3 text-xs")}>View</a>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {myTeams.length > 5 && (
              <div class="px-5 py-3 border-t border-(--color-border)">
                <a href="/my-teams" class="text-sm text-(--color-primary) hover:underline">
                  View all {myTeams.length} teams →
                </a>
              </div>
            )}
          </SectionCard>
        )}

        <div class="flex items-center justify-between">
          <h2 class="font-display text-lg font-semibold text-(--color-foreground)">My Registrations</h2>
          <a href="/tournaments" class={cn(buttonVariants({ variant: "outline" }), "h-8 px-3 text-sm")}>
            Browse tournaments
          </a>
        </div>
        {myRegistrations.length === 0 ? (
          <SectionCard class="p-8 text-center">
            <p class="text-sm text-(--color-muted) mb-4">No tournament registrations yet.</p>
            <a href="/tournaments" class={cn(buttonVariants({ variant: "default" }))}>Browse tournaments</a>
          </SectionCard>
        ) : (
          <SectionCard>
            <ul>
              {myRegistrations.slice(0, 8).map((reg) => (
                <li class="flex items-center justify-between px-5 py-3 border-b border-(--color-border-soft) last:border-0">
                   <div class="min-w-0">
                     <p class="text-sm font-medium text-(--color-foreground) truncate">{reg.tournamentName ?? reg.tournamentId}</p>
                     <p class="text-xs text-(--color-muted)">{reg.divisionName} · {reg.registeredAt.slice(0, 10)}</p>
                   </div>
                  <span class={cn(
                    "text-xs font-medium px-2 py-0.5 rounded-full shrink-0 ml-3",
                    reg.status === "approved"   && "bg-emerald-100 text-emerald-700",
                    reg.status === "pending"    && "bg-amber-100 text-amber-700",
                    reg.status === "waitlisted" && "bg-sky-100 text-sky-700",
                    reg.status === "rejected"   && "bg-red-100 text-red-700",
                  )}>
                    {reg.status}
                  </span>
                </li>
              ))}
            </ul>
          </SectionCard>
        )}
      </div>
    )}

    {/* ── No-capability fallback (should be rare — middleware redirects first) */}
    {!isCoach && !isDirector && !isAdmin && (
      <SectionCard class="p-8 text-center">
        <p class="text-sm font-medium text-(--color-foreground) mb-1">No capabilities set</p>
        <p class="text-sm text-(--color-muted) mb-4">
          Choose whether you're a Coach, a Tournament Director, or both to unlock
          the relevant sections of the app.
        </p>
        <a href="/settings" class={cn(buttonVariants({ variant: "default" }))}>
          Set up capabilities
        </a>
      </SectionCard>
    )}

    {/* ── Director section ────────────────────────────────────────── */}
    {isDirector && !isAdmin && (
      <div class="space-y-6">
        <div class="flex items-center justify-between">
          <h2 class="font-display text-lg font-semibold text-(--color-foreground)">My Tournaments</h2>
          <a href="/director/tournaments/new" class={cn(buttonVariants({ variant: "outline" }), "h-8 px-3 text-sm")}>
            + New Tournament
          </a>
        </div>
        {myTournaments.length === 0 ? (
          <SectionCard class="p-8 text-center">
            <p class="text-sm text-(--color-muted) mb-4">You haven't created any tournaments yet.</p>
            <a href="/director/tournaments/new" class={cn(buttonVariants({ variant: "default" }))}>Create a tournament</a>
          </SectionCard>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {myTournaments.slice(0, 6).map((t) => (
              <a
                href={`/director/tournaments/${t.id}`}
                class="flex items-center gap-3 p-4 rounded-xl border border-(--color-border) bg-(--color-card) hover:bg-(--color-border-soft) transition-colors cursor-pointer"
              >
                <div class="w-9 h-9 rounded-lg bg-(--color-primary-subtle) flex items-center justify-center text-lg shrink-0">🏆</div>
                <div class="min-w-0">
                  <p class="text-sm font-medium text-(--color-foreground) truncate">{t.name}</p>
                  <p class="text-xs text-(--color-muted)">{t.startDate ?? "No date set"}</p>
                </div>
              </a>
            ))}
          </div>
        )}

        {pendingRegistrations.length > 0 && (
          <>
            <h2 class="font-display text-lg font-semibold text-(--color-foreground)">Pending Registrations</h2>
            <SectionCard>
              <ul>
                {pendingRegistrations.slice(0, 5).map((reg) => (
                  <li class="flex items-center justify-between px-5 py-3 border-b border-(--color-border-soft) last:border-0">
                    <div class="min-w-0">
                      <p class="text-sm font-medium text-(--color-foreground) truncate">{reg.teamName}</p>
                      <p class="text-xs text-(--color-muted)">{reg.divisionName}</p>
                    </div>
                    <a
                      href={`/director/tournaments/${reg.tournamentId}/registrations`}
                      class="text-xs text-(--color-primary) hover:underline cursor-pointer shrink-0 ml-3"
                    >
                      Review →
                    </a>
                  </li>
                ))}
              </ul>
            </SectionCard>
          </>
        )}
      </div>
    )}
  </div>
</AppLayout>
