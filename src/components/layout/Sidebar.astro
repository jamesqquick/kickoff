---
import BrandMark from "@/components/BrandMark.astro";
import { UserMenu } from "@/components/layout/UserMenu";
import { TournamentSwitcher } from "@/components/layout/TournamentSwitcher";
import { TeamMemberRepository } from "@/repositories/team-member-repository";
import { makeTournamentService } from "@/services/tournament-service";
import { getDb } from "@/lib/db";
import { getTournamentStatus } from "@/lib/utils";

interface Props {
  activeNav?: string;
}
const { activeNav = "my-teams" } = Astro.props;

const user = Astro.locals.user;
const displayName = user?.name?.trim() || user?.email || "Account";
const role = (user as { role?: string } | null)?.role ?? "Member";
const isAdmin = user?.role === "admin";
const initials =
  displayName
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .join("") || "?";

// Determine context from the current URL.
const pathname = Astro.url.pathname;
const isAdminRoute = pathname.startsWith("/admin");

// Parse tournament context: /admin/tournaments/[id] or /admin/tournaments/[id]/[section]
const tournamentMatch = isAdminRoute
  ? pathname.match(/^\/admin\/tournaments\/([^/]+)(?:\/(.+))?$/)
  : null;
const RESERVED_SLUGS = new Set(["new"]);
const rawId = tournamentMatch?.[1];
const activeTournamentId =
  rawId && !RESERVED_SLUGS.has(rawId) ? rawId : null;
const currentSection = tournamentMatch?.[2] ?? "overview";

// "All Tournaments" is active when on an admin route but not scoped to a tournament.
const isOnAllTournaments = isAdminRoute && !activeTournamentId && pathname !== "/admin";

// Fetch tournament list only on admin routes (saves a DB call on every user page).
const allTournaments =
  isAdmin && isAdminRoute
    ? await makeTournamentService().listTournaments()
    : [];
const tournamentsForSwitcher = allTournaments.map((t) => ({
  id: t.id,
  name: t.name,
  status: getTournamentStatus(t),
}));

// My Teams badge count — only needed on user-facing routes.
const myTeamsCount =
  user && !isAdminRoute
    ? await new TeamMemberRepository(getDb()).countConfirmedForUser(user.id)
    : 0;

function getIcon(name: string) {
  const icons: Record<string, string> = {
    "grid-2x2":    "▦",
    trophy:        "🏆",
    shield:        "🛡️",
    users:         "👥",
    calendar:      "📅",
    "map-pin":     "📍",
    scale:         "⚖️",
    "credit-card": "💳",
    user:          "👤",
    settings:      "⚙️",
    list:          "☰",
  };
  return icons[name] ?? "·";
}

// User-facing nav groups (shown when NOT on an admin route).
const userNavGroups = [
  {
    label: "Overview",
    items: [
      {
        id: "my-teams",
        label: "My Teams",
        href: "/my-teams",
        icon: "shield",
        count: myTeamsCount > 0 ? String(myTeamsCount) : undefined,
      },
      { id: "tournaments", label: "Tournaments", href: "/tournaments", icon: "trophy", count: undefined },
      { id: "schedule",    label: "Schedule",    href: "/schedule",    icon: "calendar", count: undefined },
    ],
  },
  {
    label: "Account",
    items: [
      { id: "profile",  label: "My Profile", href: "/profile",  icon: "user",     count: undefined },
      { id: "settings", label: "Settings",   href: "/settings", icon: "settings", count: undefined },
    ],
  },
];

// Tournament-scoped admin nav links — only shown when a specific tournament is selected.
const adminTournamentLinks = activeTournamentId
  ? [
      { section: "overview",       label: "Overview",       href: `/admin/tournaments/${activeTournamentId}`,               icon: "grid-2x2" },
      { section: "registrations",  label: "Registrations",  href: `/admin/tournaments/${activeTournamentId}/registrations`,  icon: "users"    },
      { section: "teams",          label: "Teams",          href: `/admin/tournaments/${activeTournamentId}/teams`,          icon: "shield"   },
      { section: "schedule",       label: "Schedule",       href: `/admin/tournaments/${activeTournamentId}/schedule`,       icon: "calendar" },
      { section: "edit",           label: "Settings",       href: `/admin/tournaments/${activeTournamentId}/edit`,           icon: "settings" },
    ]
  : [];
---

<!--
  On mobile/tablet (< lg): fixed overlay, starts off-screen (-translate-x-full),
  toggled to translate-x-0 by the hamburger button in AppLayout.
  On desktop (lg+): sticky, always visible.
  h-screen (not min-h-screen) pins the aside to the viewport so the nav scrolls
  internally and the user footer stays visible.
-->
<aside
  id="sidebar"
  class="fixed lg:sticky inset-y-0 left-0 z-50 w-[248px] shrink-0 flex flex-col bg-(--color-surface) border-r border-(--color-border) h-screen -translate-x-full lg:translate-x-0 transition-transform duration-200"
>
  <!-- Brand -->
  <div class="flex items-center gap-2.5 px-5 py-5 border-b border-(--color-border)">
    <BrandMark size="sm" />
    <span class="font-display font-bold text-[17px] text-(--color-foreground) flex-1">Kickoff</span>
    <!-- Close button — mobile/tablet only -->
    <button
      id="sidebar-close"
      class="lg:hidden flex items-center justify-center w-8 h-8 rounded-md text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground) transition-colors cursor-pointer"
      aria-label="Close menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Nav -->
  <nav class="flex-1 px-3 py-4 overflow-y-auto">
    {isAdmin && isAdminRoute ? (
      /* ── Admin nav ─────────────────────────────────────── */
      <div>
        <p class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wider text-(--color-muted-fg)">
          Admin
        </p>

        <!-- Tournament picker -->
        <TournamentSwitcher
          client:load
          tournaments={tournamentsForSwitcher}
          activeTournamentId={activeTournamentId}
          currentSection={currentSection}
        />

        <!-- Tournament-scoped links -->
        {adminTournamentLinks.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
              currentSection === item.section
                ? "bg-(--color-primary-subtle) text-(--color-primary)"
                : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
            ]}
          >
            <span class="text-base leading-none">{getIcon(item.icon)}</span>
            <span class="flex-1">{item.label}</span>
          </a>
        ))}

        <!-- Divider before management link -->
        {adminTournamentLinks.length > 0 && (
          <div class="my-2 border-t border-(--color-border)" />
        )}

        <!-- All Tournaments (management) -->
        <a
          href="/admin/tournaments"
          class:list={[
            "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
            isOnAllTournaments
              ? "bg-(--color-primary-subtle) text-(--color-primary)"
              : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
          ]}
        >
          <span class="text-base leading-none">{getIcon("trophy")}</span>
          <span class="flex-1">All Tournaments</span>
        </a>

        <!-- Back to user area -->
        <div class="mt-4 pt-3 border-t border-(--color-border)">
          <a
            href="/my-teams"
            class="flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground) transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
              <path d="m15 18-6-6 6-6"/>
            </svg>
            <span class="flex-1">My Teams</span>
          </a>
        </div>
      </div>
    ) : (
      /* ── User nav ──────────────────────────────────────── */
      userNavGroups.map((group, gi) => (
        <div class:list={["mb-1", gi > 0 && "mt-3"]}>
          <p class="px-3 py-2 text-[11px] font-semibold uppercase tracking-wider text-(--color-muted-fg)">
            {group.label}
          </p>
          {group.items.map((item) => (
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
                activeNav === item.id
                  ? "bg-(--color-primary-subtle) text-(--color-primary)"
                  : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
              ]}
            >
              <span class="text-base leading-none">{getIcon(item.icon)}</span>
              <span class="flex-1">{item.label}</span>
              {item.count && (
                <span class="text-[11px] bg-(--color-border-soft) text-(--color-muted) px-1.5 py-0.5 rounded-full">
                  {item.count}
                </span>
              )}
            </a>
          ))}
        </div>
      ))
    )}
  </nav>

  <!-- User footer -->
  <div class="p-3 border-t border-(--color-border)">
    <UserMenu
      client:load
      name={displayName}
      email={user?.email ?? ""}
      role={role}
      initials={initials}
      showAdminLink={isAdmin && !isAdminRoute}
    />
  </div>
</aside>
