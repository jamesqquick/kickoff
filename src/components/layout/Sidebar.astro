---
// Single persistent capability-driven sidebar.
// No context-switching, no mode toggle.
// Each section is shown based on the user's isCoach / isDirector / role flags.
import BrandMark from "@/components/BrandMark.astro";
import { UserMenu } from "@/components/layout/UserMenu";
import { NotificationBell } from "@/components/NotificationBell";
import { TeamMemberRepository } from "@/repositories/team-member-repository";
import { makeNotificationService } from "@/services/notification-service";
import { getDb } from "@/lib/db";

interface Props {
  activeNav?: string;
}
const { activeNav = "dashboard" } = Astro.props;

const user = Astro.locals.user;
const displayName = user?.name?.trim() || user?.email || "Account";
const initials =
  displayName
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .join("") || "?";

const isAdmin = user?.role === "admin";
const isCoach = !!user?.isCoach || isAdmin;
const isDirector = !!user?.isDirector || isAdmin;

// My Teams badge — only for users with coach capability
const myTeamsCount =
  user && isCoach
    ? await new TeamMemberRepository(getDb()).countConfirmedForUser(user.id)
    : 0;

// Notification unread count — fetched server-side so the badge is correct on first paint.
const unreadNotificationCount = user
  ? await makeNotificationService().unreadCount(user.id)
  : 0;

function navItem(id: string, label: string, href: string, icon: string, count?: string) {
  return { id, label, href, icon, count };
}

const icons: Record<string, string> = {
  "grid-2x2": "▦",
  trophy:     "🏆",
  shield:     "🛡️",
  users:      "👥",
  calendar:   "📅",
  user:       "👤",
  settings:   "⚙️",
  list:       "☰",
  star:       "★",
};

function getIcon(name: string) {
  return icons[name] ?? "·";
}
---

<aside
  id="sidebar"
  class="fixed lg:sticky inset-y-0 left-0 z-50 w-[248px] shrink-0 flex flex-col bg-(--color-surface) border-r border-(--color-border) h-screen -translate-x-full lg:translate-x-0 transition-transform duration-200"
>
  <!-- Brand -->
  <div class="flex items-center gap-2.5 px-5 py-5 border-b border-(--color-border)">
    <BrandMark size="sm" />
    <span class="font-display font-bold text-[17px] text-(--color-foreground) flex-1">Kickoff</span>
    {user && (
      <NotificationBell
        client:load
        initialUnreadCount={unreadNotificationCount}
      />
    )}
    <button
      id="sidebar-close"
      class="lg:hidden flex items-center justify-center w-8 h-8 rounded-md text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground) transition-colors cursor-pointer"
      aria-label="Close menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Nav -->
  <nav class="flex-1 px-3 py-4 overflow-y-auto space-y-4">

    <!-- ── Overview group ────────────────────────────────────────── -->
    <div>
      <p class="px-3 pb-1 text-[11px] font-semibold uppercase tracking-wider text-(--color-muted-fg)">Overview</p>

      <!-- Dashboard — always visible -->
      <a
        href="/dashboard"
        class:list={[
          "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
          activeNav === "dashboard"
            ? "bg-(--color-primary-subtle) text-(--color-primary)"
            : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
        ]}
      >
        <span class="text-base leading-none">{getIcon("grid-2x2")}</span>
        <span class="flex-1">Dashboard</span>
      </a>

      <!-- My Teams — coach only -->
      {isCoach && (
        <a
          href="/my-teams"
          class:list={[
            "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
            activeNav === "my-teams"
              ? "bg-(--color-primary-subtle) text-(--color-primary)"
              : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
          ]}
        >
          <span class="text-base leading-none">{getIcon("shield")}</span>
          <span class="flex-1">My Teams</span>
          {myTeamsCount > 0 && (
            <span class="text-[11px] bg-(--color-border-soft) text-(--color-muted) px-1.5 py-0.5 rounded-full">
              {myTeamsCount}
            </span>
          )}
        </a>
      )}

      <!-- My Registrations — coach only -->
      {isCoach && (
        <a
          href="/registrations"
          class:list={[
            "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
            activeNav === "registrations"
              ? "bg-(--color-primary-subtle) text-(--color-primary)"
              : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
          ]}
        >
          <span class="text-base leading-none">📋</span>
          <span class="flex-1">My Registrations</span>
        </a>
      )}

      <!-- My Tournaments — director only -->
      {isDirector && (
        <a
          href="/director/tournaments"
          class:list={[
            "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
            activeNav === "director-tournaments" || activeNav?.startsWith("director-")
              ? "bg-(--color-primary-subtle) text-(--color-primary)"
              : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
          ]}
        >
          <span class="text-base leading-none">{getIcon("trophy")}</span>
          <span class="flex-1">My Tournaments</span>
        </a>
      )}

      <!-- Browse Tournaments — coach or admin -->
      {(isCoach || isAdmin) && (
        <a
          href="/tournaments"
          class:list={[
            "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
            activeNav === "tournaments"
              ? "bg-(--color-primary-subtle) text-(--color-primary)"
              : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
          ]}
        >
          <span class="text-base leading-none">{getIcon("list")}</span>
          <span class="flex-1">Browse Tournaments</span>
        </a>
      )}

      <!-- Schedule — always visible -->
      <a
        href="/schedule"
        class:list={[
          "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
          activeNav === "schedule"
            ? "bg-(--color-primary-subtle) text-(--color-primary)"
            : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
        ]}
      >
        <span class="text-base leading-none">{getIcon("calendar")}</span>
        <span class="flex-1">Schedule</span>
      </a>
    </div>

    <!-- ── Platform section — admin only ─────────────────────────── -->
    {isAdmin && (
      <div>
        <p class="px-3 pb-1 text-[11px] font-semibold uppercase tracking-wider text-(--color-muted-fg)">Platform</p>
        <a
          href="/admin/users"
          class:list={[
            "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
            activeNav === "admin-users"
              ? "bg-(--color-primary-subtle) text-(--color-primary)"
              : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
          ]}
        >
          <span class="text-base leading-none">{getIcon("users")}</span>
          <span class="flex-1">All Users</span>
        </a>
        <a
          href="/admin/tournaments"
          class:list={[
            "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
            activeNav === "admin-tournaments"
              ? "bg-(--color-primary-subtle) text-(--color-primary)"
              : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
          ]}
        >
          <span class="text-base leading-none">{getIcon("trophy")}</span>
          <span class="flex-1">All Tournaments</span>
        </a>
        <a
          href="/admin/teams"
          class:list={[
            "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
            activeNav === "admin-teams"
              ? "bg-(--color-primary-subtle) text-(--color-primary)"
              : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
          ]}
        >
          <span class="text-base leading-none">{getIcon("shield")}</span>
          <span class="flex-1">All Teams</span>
        </a>
      </div>
    )}

    <!-- ── Account group ──────────────────────────────────────────── -->
    <div>
      <p class="px-3 pb-1 text-[11px] font-semibold uppercase tracking-wider text-(--color-muted-fg)">Account</p>
      <a
        href="/profile"
        class:list={[
          "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
          activeNav === "profile"
            ? "bg-(--color-primary-subtle) text-(--color-primary)"
            : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
        ]}
      >
        <span class="text-base leading-none">{getIcon("user")}</span>
        <span class="flex-1">My Profile</span>
      </a>
      <a
        href="/settings"
        class:list={[
          "flex items-center gap-3 px-3 py-2 rounded-[8px] text-sm font-medium mb-0.5 transition-colors",
          activeNav === "settings"
            ? "bg-(--color-primary-subtle) text-(--color-primary)"
            : "text-(--color-muted) hover:bg-(--color-border-soft) hover:text-(--color-foreground)",
        ]}
      >
        <span class="text-base leading-none">{getIcon("settings")}</span>
        <span class="flex-1">Settings</span>
      </a>
    </div>

  </nav>

  <!-- User footer -->
  <div class="p-3 border-t border-(--color-border)">
    <UserMenu
      client:load
      name={displayName}
      email={user?.email ?? ""}
      role={isAdmin ? "Admin" : isDirector && isCoach ? "Coach + Director" : isDirector ? "Tournament Director" : "Coach"}
      initials={initials}
    />
  </div>
</aside>
